{
  "name": "graph-scope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun --hot server/index.ts\" \"vite --host 127.0.0.1\"",
    "server": "bun server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "bun test",
    "check": "tsc -b --pretty false && biome check .",
    "format": "biome format --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  }
}
